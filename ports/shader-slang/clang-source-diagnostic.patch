diff --git a/cmake/RegenerateDllExports.cmake b/cmake/RegenerateDllExports.cmake
index 6442bce..72e92cc 100644
--- a/cmake/RegenerateDllExports.cmake
+++ b/cmake/RegenerateDllExports.cmake
@@ -27,6 +27,55 @@ if(NOT EXISTS "${DLL_PATH}")
     message(FATAL_ERROR "DLL not found: ${DLL_PATH}")
 endif()
 
+find_program(LLVM_READOBJ_EXECUTABLE llvm-readobj)
+if(LLVM_READOBJ_EXECUTABLE)
+    execute_process(
+        COMMAND "${LLVM_READOBJ_EXECUTABLE}" --sections --coff-exports "${DLL_PATH}"
+        OUTPUT_VARIABLE LLVM_OUTPUT ERROR_VARIABLE LLVM_ERROR RESULT_VARIABLE LLVM_RESULT
+    )
+    if(NOT LLVM_RESULT EQUAL 0)
+        message(FATAL_ERROR "llvm-readobj failed: ${LLVM_ERROR}")
+    endif()
+    string(REGEX MATCHALL "Section \\{[^}]*\\}" SECTIONS "${LLVM_OUTPUT}")
+    set(EXECUTABLE_RANGES "")
+    foreach(SECTION IN LISTS SECTIONS)
+        if(SECTION MATCHES "IMAGE_SCN_MEM_EXECUTE")
+            string(REGEX MATCH "VirtualAddress: (0x[0-9A-Fa-f]+)" _ "${SECTION}")
+            set(START "${CMAKE_MATCH_1}")
+            string(REGEX MATCH "VirtualSize: (0x[0-9A-Fa-f]+)" _ "${SECTION}")
+            math(EXPR END "${START} + ${CMAKE_MATCH_1}")
+            list(APPEND EXECUTABLE_RANGES "${START},${END}")
+        endif()
+    endforeach()
+    string(REGEX MATCHALL "Export \\{[^}]*\\}" EXPORTS "${LLVM_OUTPUT}")
+    set(DEF_CONTENT "LIBRARY slang\nEXPORTS\n")
+    set(NUM_EXPORTS 0)
+    foreach(EXPORT IN LISTS EXPORTS)
+        string(REGEX MATCH "Name: ([^\r\n]+)" _ "${EXPORT}")
+        set(FUNC "${CMAKE_MATCH_1}")
+        string(REGEX MATCH "RVA: (0x[0-9A-Fa-f]+)" _ "${EXPORT}")
+        set(RVA "${CMAKE_MATCH_1}")
+        if(FUNC AND RVA)
+            foreach(RANGE IN LISTS EXECUTABLE_RANGES)
+                string(REPLACE "," ";" BOUNDS "${RANGE}")
+                list(GET BOUNDS 0 START)
+                list(GET BOUNDS 1 END)
+                if(RVA GREATER_EQUAL START AND RVA LESS END)
+                    string(APPEND DEF_CONTENT "    ${FUNC} = ${TARGET_DLL_NAME}.${FUNC}\n")
+                    math(EXPR NUM_EXPORTS "${NUM_EXPORTS} + 1")
+                    break()
+                endif()
+            endforeach()
+        endif()
+    endforeach()
+    if(NUM_EXPORTS EQUAL 0)
+        message(FATAL_ERROR "No executable exports found in ${DLL_PATH}")
+    endif()
+    file(WRITE "${OUTPUT_DEF}" "${DEF_CONTENT}")
+    message(STATUS "Generated ${OUTPUT_DEF} with ${NUM_EXPORTS} executable exports using llvm-readobj")
+    return()
+endif()
+
 # Find dumpbin - should be available in Visual Studio environment
 find_program(DUMPBIN_EXECUTABLE dumpbin)
 if(NOT DUMPBIN_EXECUTABLE)
