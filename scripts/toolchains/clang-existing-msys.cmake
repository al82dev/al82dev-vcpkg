# Use only the explicitly configured existing MSYS2 installation for helpers.
# This function never downloads packages or modifies that installation.
if(DEFINED CMD AND CMD STREQUAL "BUILD")
    file(STRINGS "${CMAKE_CURRENT_LIST_DIR}/../../clang-integration/config.cmd" _clang_sdk_config)
    foreach(_clang_key IN ITEMS CLANG_SYSROOT CLANG_SDK_VERSION)
        set(_clang_found OFF)
        foreach(_clang_line IN LISTS _clang_sdk_config)
            if(_clang_line MATCHES "^set \"${_clang_key}=([^\"]+)\"$")
                if(_clang_found)
                    message(FATAL_ERROR "Duplicate configuration setting: ${_clang_key}")
                endif()
                set("_${_clang_key}" "${CMAKE_MATCH_1}")
                set(_clang_found ON)
            endif()
        endforeach()
        if(NOT _clang_found)
            message(FATAL_ERROR "Missing configuration setting: ${_clang_key}")
        endif()
    endforeach()
    set(VCPKG_CLANG_SDK_VERSION "${_CLANG_SDK_VERSION}")
    set(VCPKG_CLANG_SDK_ROOT "${_CLANG_SYSROOT}/windows-sdk/${_CLANG_SDK_VERSION}")
    file(STRINGS "${CMAKE_CURRENT_LIST_DIR}/../../clang-integration/config.cmd" _clang_msys_config
         REGEX "^set \"CLANG_MSYS_ROOT=[^\"]+\"$")
    list(LENGTH _clang_msys_config _clang_msys_count)
    if(NOT _clang_msys_count EQUAL 1)
        message(FATAL_ERROR "Configure exactly one CLANG_MSYS_ROOT in clang-integration/config.cmd")
    endif()
    list(GET _clang_msys_config 0 _clang_msys_line)
    string(REGEX REPLACE "^set \"CLANG_MSYS_ROOT=([^\"]+)\"$" "\\1" _clang_msys_root "${_clang_msys_line}")

    function(vcpkg_acquire_msys out_msys_root)
        cmake_parse_arguments(PARSE_ARGV 1 arg "NO_DEFAULT_PACKAGES;Z_ALL_PACKAGES"
            "Z_DECLARE_EXTRA_PACKAGES_COMMAND" "PACKAGES;DIRECT_PACKAGES")
        if(arg_UNPARSED_ARGUMENTS OR arg_DIRECT_PACKAGES OR arg_Z_ALL_PACKAGES)
            message(FATAL_ERROR "This request cannot be resolved safely from the existing MSYS2 root: ${_clang_msys_root}")
        endif()
        foreach(tool IN ITEMS bash.exe make.exe)
            if(NOT EXISTS "${_clang_msys_root}/usr/bin/${tool}")
                message(FATAL_ERROR "Missing MSYS2 helper ${tool} in ${_clang_msys_root}/usr/bin")
            endif()
        endforeach()
        set(requested ${arg_PACKAGES})
        if(NOT arg_NO_DEFAULT_PACKAGES)
            list(APPEND requested bash coreutils file gawk grep gzip diffutils make pkgconf sed)
        endif()
        list(REMOVE_DUPLICATES requested)
        foreach(pkg IN LISTS requested)
            if(NOT pkg MATCHES "^[A-Za-z0-9_+.-]+$")
                message(FATAL_ERROR "Invalid MSYS2 package name: ${pkg}")
            endif()
            file(GLOB installed LIST_DIRECTORIES true "${_clang_msys_root}/var/lib/pacman/local/${pkg}-[0-9]*")
            if(NOT installed)
                message(FATAL_ERROR "MSYS2 helper package '${pkg}' was requested but is not installed in ${_clang_msys_root}; install it separately before retrying.")
            endif()
        endforeach()
        message(STATUS "Using configured existing MSYS2 helpers at ${_clang_msys_root}")
        set("${out_msys_root}" "${_clang_msys_root}" PARENT_SCOPE)
    endfunction()
endif()
